<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.262.0</Version>
    <TargetFrameworks Condition="$(IsNCrunch)">net10.0;net9.0;net8.0;net7.0;net6.0</TargetFrameworks> <!-- NCrunch Package TrimTests -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JJ.Framework.Xml.Tests\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="..\JJ.Framework.Xml.Tests\obj\**" />
    <Compile Remove="..\JJ.Framework.Xml.Tests\bin\**" />
    <Compile Include="..\Xml.Legacy.TrimTests\Program.cs" />
  </ItemGroup>
    
  <ItemGroup>
    <EmbeddedResource Include="..\JJ.Framework.Xml.Tests\TestResources\ComplicatedExample.xml" Link="TestResources\ComplicatedExample.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JJ.Framework.Xml.Legacy" Version="0.262.7664" />
    <PackageReference Include="JJ.Framework.IO.Legacy" Version="0.262.7664" />
    <PackageReference Include="JJ.Framework.Testing.Legacy" Version="0.262.7661" />
    <PackageReference Include="JJ.Framework.PlatformCompatibility.Core" Version="5.4.7664" />
    <PackageReference Include="JJ.Framework.Testing.Core" Version="5.4.7661" />
    <PackageReference Include="JJ.Framework.Testing.Core.NCrunchless" Version="5.4.7661" />
    <PackageReference Include="JJ.Framework.Testing.Core.MSTestless" Version="5.4.7661" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="Linker.xml" />
    <TrimmerRootAssembly Include="nCrunch.TestRuntime.DotNetCore" />
  </ItemGroup>

  <Import Project="..\SharedProject.Core\JJ.Framework.SharedProject.Core.projitems" Label="Shared" />
</Project>
