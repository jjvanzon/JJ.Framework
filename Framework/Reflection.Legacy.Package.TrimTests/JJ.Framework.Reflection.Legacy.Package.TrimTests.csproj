    <PackageReference Include="JJ.Framework.Reflection.Legacy" Version="0.261.7644" />
    <PackageReference Include="JJ.Framework.Testing.Core" Version="5.3.7602" />
    <PackageReference Include="JJ.Framework.Testing.Legacy" Version="0.261.7602" />
    <PackageReference Include="JJ.Framework.PlatformCompatibility.Core" Version="5.3.7644" />
    <PackageReference Include="JJ.Framework.Testing.Core.MSTestless" Version="5.3.7602" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reflection.Legacy.Tests.HelpersEx\JJ.Framework.Reflection.Legacy.Tests.HelpersEx.csproj" />
  </ItemGroup>

  <Import Project="..\SharedProject.Core\JJ.Framework.SharedProject.Core.projitems" Label="Shared" />

