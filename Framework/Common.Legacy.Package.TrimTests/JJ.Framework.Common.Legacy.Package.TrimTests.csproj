<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.260.0</Version>
    <TargetFrameworks Condition="$(IsNCrunch)">net10.0;net9.0;net8.0;net7.0;net6.0</TargetFrameworks> <!-- NCrunch Package TrimTests -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JJ.Framework.Common.Legacy" Version="0.260.7464" />
    <PackageReference Include="JJ.Framework.Common.Core.Tests.Helpers" Version="3.7.4872" />
    <PackageReference Include="JJ.Framework.IO.Legacy" Version="0.260.7464" />
    <PackageReference Include="JJ.Framework.Testing.Core" Version="5.2.7464" />
    <PackageReference Include="JJ.Framework.PlatformCompatibility.Core" Version="5.2.7464" />
    <PackageReference Include="JJ.Framework.Testing.Core.MSTestless" Version="5.2.7464" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\JJ.Framework.Common.Tests\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="..\JJ.Framework.Common.Tests\obj\**" />
    <Compile Remove="..\JJ.Framework.Common.Tests\bin\**" />
    <Compile Include="..\Common.Legacy.TrimTests\Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\JJ.Framework.Common.Tests\EmbeddedResourceFile1_WithoutSubNameSpace.txt" />
    <EmbeddedResource Include="..\JJ.Framework.Common.Tests\EmbeddedResourceFile2_WithoutSubNameSpace.txt" />
    <EmbeddedResource Include="..\JJ.Framework.Common.Tests\TestResources\EmbeddedResourceFile1_WithSubNameSpace.txt" Link="TestResources\EmbeddedResourceFile1_WithSubNameSpace.txt" />
    <EmbeddedResource Include="..\JJ.Framework.Common.Tests\TestResources\EmbeddedResourceFile2_WithSubNameSpace.txt" Link="TestResources\EmbeddedResourceFile2_WithSubNameSpace.txt" />
  </ItemGroup>

  <Import Project="..\SharedProject.Core\JJ.Framework.SharedProject.Core.projitems" Label="Shared" />

  <ItemGroup>
    <TrimmerRootDescriptor Include="Linker.xml" />
  </ItemGroup>
</Project>

