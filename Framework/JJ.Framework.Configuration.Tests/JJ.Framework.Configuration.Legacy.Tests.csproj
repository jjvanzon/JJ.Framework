<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="$(IsNCrunch)">net10.0;net5.0;net461</TargetFrameworks> <!-- NCrunch Tests 3 TFMs -->
    <TargetFrameworks Condition="!$(IsNCrunch)">net10.0;net9.0;net8.0;net7.0;net6.0;net5.0;net461</TargetFrameworks> <!-- TODO: Errors for net462 and net48 in Visual Studio Test Explorer. -->
    <Version>0.261.0</Version>
  </PropertyGroup>
  
  <!-- Manage Legacy code namespace expectations -->
  <PropertyGroup>
    <!-- Legacy code expects this name for configuration section resolution. -->
    <AssemblyName>JJ.Framework.Configuration.Tests</AssemblyName>
    <!-- Then this is required for the EmbeddedResources to use that assembly name. -->
    <RootNamespace>JJ.Framework.Configuration.Tests</RootNamespace>
     <!-- Then squelch warning Namespace != Folder -->
    <NoWarn>$(NoWarn);IDE0130</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JJ.Framework.Configuration\JJ.Framework.Configuration.Legacy.csproj" />
    <ProjectReference Include="..\JJ.Framework.Testing\JJ.Framework.Testing.Legacy.csproj" />
    <ProjectReference Include="..\Testing.Core\JJ.Framework.Testing.Core.csproj" />
    <ProjectReference Include="..\Compilation.Core\JJ.Framework.Compilation.Core.csproj" />
  </ItemGroup>
    
  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.7.3" />
  </ItemGroup>

  <!-- Awkwardly Include Microsoft's ConfigurationManager package. -->
  <ItemGroup Condition="'$(TargetFramework)'!='net461' And '$(TargetFramework)'!='net462' And '$(TargetFramework)'!='net48' ">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.3" />
  </ItemGroup>

  <!-- Embed Dummy Project Files for Tests -->
  <ItemGroup>
    <EmbeddedResource Include="..\Configuration.Legacy.Tests.Dummy\*.cs" Link="TestResources\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Configuration.Legacy.Tests.Dummy\*.config" Link="TestResources\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Configuration.Legacy.Tests.Dummy\JJ.Framework.Configuration.Legacy.Tests.Dummy.csproj" Link="TestResources\JJ.Framework.Configuration.Tests.Dummy.csproj" />
    <EmbeddedResource Include="..\JJ.Framework.Configuration\build\JJ.Framework.Configuration.Legacy.targets" Link="TestResources\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Simulate what NuGet consumers get automatically via the build/ convention. -->
  <Import Project="..\JJ.Framework.Configuration\build\JJ.Framework.Configuration.Legacy.targets" />
  
</Project>