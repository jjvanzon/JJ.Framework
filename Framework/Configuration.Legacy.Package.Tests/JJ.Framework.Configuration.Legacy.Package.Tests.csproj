<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0;net5.0;net461</TargetFrameworks> <!-- NCrunch wide range for Package.Tests. -->
    <Version>0.261.0</Version>
  </PropertyGroup>
  
  <!-- Manage Legacy code namespace expectations -->
  <PropertyGroup>
    <!-- Legacy code expects this name for configuration section resolution. -->
    <AssemblyName>JJ.Framework.Configuration.Tests</AssemblyName>
    <!-- Then this is required for the EmbeddedResources to use that assembly name. -->
    <RootNamespace>JJ.Framework.Configuration.Tests</RootNamespace>
     <!-- Then squelch warning Namespace != Folder -->
    <NoWarn>$(NoWarn);IDE0130</NoWarn>
  </PropertyGroup>

  <!-- Embed Dummy Project Files for Tests -->
  <ItemGroup>
    <EmbeddedResource Include="..\Configuration.Legacy.Tests.Dummy\*.cs" Link="TestResources\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Configuration.Legacy.Tests.Dummy\*.config" Link="TestResources\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Configuration.Legacy.Package.Tests.Dummy\JJ.Framework.Configuration.Legacy.Package.Tests.Dummy.csproj" Link="TestResources\JJ.Framework.Configuration.Tests.Dummy.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="..\JJ.Framework.Configuration.Tests\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="..\JJ.Framework.Configuration.Tests\obj\**" />
    <Compile Remove="..\JJ.Framework.Configuration.Tests\bin\**" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.7.3" />
    <PackageReference Include="JJ.Framework.Configuration.Legacy" Version="0.261.7602" />
    <PackageReference Include="JJ.Framework.Testing.Legacy" Version="0.261.7602" />
    <PackageReference Include="JJ.Framework.Testing.Core" Version="5.3.7602" />
    <PackageReference Include="JJ.Framework.Compilation.Core" Version="5.3.7624-preview" />
  </ItemGroup>
  
  <!-- Awkwardly Include Microsoft's ConfigurationManager package. -->
  <!--<ItemGroup Condition="'$(TargetFramework)'!='net461'">-->
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.3" />
  </ItemGroup>
</Project>
